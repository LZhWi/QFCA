import { test, expect, afterEach } from 'vitest';
import { generateKeyPairSync, sign } from 'node:crypto';
import { readFileSync, mkdtempSync, rmSync } from 'node:fs';
import { join, isAbsolute } from 'node:path';
import { pathToFileURL } from 'node:url';
import { tmpdir } from 'node:os';
import { verifyQqPackage, QQ_PACKAGE_SIGNATURE_DOMAIN } from './package-verifier';
import { QqPackageStore } from './package-store';
const releaseRoot = process.env.QFCA_RELEASE_ROOT;
if (!releaseRoot || !isAbsolute(releaseRoot)) throw new Error('QFCA_RELEASE_ROOT must be an absolute reviewed QFCA checkout');
const release = await import(/* @vite-ignore */ pathToFileURL(join(releaseRoot, 'scripts/release/package.mjs')).href);
const plan = JSON.parse(readFileSync(join(releaseRoot, 'scripts/release/rehearsal-plan.json'), 'utf8'));
// Builds without network or lifecycle scripts. Keys below exist only in memory.
const candidate = release.buildCandidate(plan, { cache: process.env.QFCA_NPM_CACHE });
const unsigned = release.decodeUnsigned(release.encodeUnsigned(candidate));
const keys=generateKeyPairSync('ed25519');
const pem=keys.publicKey.export({type:'spki',format:'pem'}).toString();
const base=JSON.parse(unsigned.manifest.toString());
function input(patch:any={}) { const manifest=Buffer.from(JSON.stringify({...base,...patch})); return {manifest,signature:sign(null,Buffer.concat([Buffer.from(QQ_PACKAGE_SIGNATURE_DOMAIN),manifest]),keys.privateKey),files:new Map(unsigned.files)}; }
const context=()=>({trustedKeys:new Map([[base.keyId,pem]]),hostVersion:'1.3.7',platform:'linux',arch:'x64',now:1500});
const dirs:string[]=[]; afterEach(()=>{for(const d of dirs.splice(0))rmSync(d,{recursive:true,force:true});});
test('actual packaged candidate accepted with exact entry and version',()=>{expect(verifyQqPackage(input(),context()).entry).toBe('dist/runtime/entry.js');expect(JSON.parse(Buffer.from(unsigned.files.get('package.json')!).toString()).version).toBe(base.version);});
test('empty pin rejected',()=>expect(()=>verifyQqPackage(input(),{...context(),trustedKeys:new Map()})).toThrow('untrusted-publisher'));
test('wrong key rejected',()=>expect(()=>verifyQqPackage(input(),{...context(),trustedKeys:new Map([[base.keyId,generateKeyPairSync('ed25519').publicKey.export({type:'spki',format:'pem'}).toString()]])})).toThrow('invalid-signature'));
test('manifest tamper rejected',()=>{const i=input();i.manifest=Buffer.from(i.manifest.toString().replace('"releaseSequence":1','"releaseSequence":2'));expect(()=>verifyQqPackage(i,context())).toThrow('invalid-signature');});
test('signature tamper rejected',()=>{const i=input();i.signature[0]^=1;expect(()=>verifyQqPackage(i,context())).toThrow('invalid-signature');});
test('payload tamper rejected',()=>{const i=input();i.files.set(base.entry,Buffer.from('bad'));expect(()=>verifyQqPackage(i,context())).toThrow('file-integrity-failed');});
test('missing file rejected',()=>{const i=input();i.files.delete(base.entry);expect(()=>verifyQqPackage(i,context())).toThrow('invalid-file-inventory');});
test('extra file rejected',()=>{const i=input();i.files.set('extra.js',Buffer.from(''));expect(()=>verifyQqPackage(i,context())).toThrow('invalid-file-inventory');});
for(const now of [999,2000,2001]) test(`invalid freshness ${now}`,()=>expect(()=>verifyQqPackage(input(),{...context(),now})).toThrow('expired-manifest'));
test('issuedAt inclusive accepted',()=>expect(verifyQqPackage(input(),{...context(),now:1000})).toBeTruthy());
for(const hostVersion of ['1.3.6','1.3.8','1.3.7-dev.0'])test(`incompatible host ${hostVersion}`,()=>expect(()=>verifyQqPackage(input(),{...context(),hostVersion})).toThrow('incompatible-package'));
test('API major mismatch',()=>expect(()=>verifyQqPackage(input({apiSupport:{major:2,minMinor:0,maxMinor:0}}),context())).toThrow('incompatible-package'));
test('API minor mismatch',()=>expect(()=>verifyQqPackage(input({apiSupport:{major:1,minMinor:1,maxMinor:1}}),context())).toThrow('incompatible-package'));
test('target mismatch',()=>expect(()=>verifyQqPackage(input(),{...context(),arch:'arm64'})).toThrow('incompatible-package'));
test('temporary store reread replay rollback revoked pin and expired read',()=>{const d=mkdtempSync(join(tmpdir(),'qfca-independent-store-'));dirs.push(d);const root=join(d,'store');let ctx=context();const store=new QqPackageStore(root,()=>ctx);const one=store.install(input(),{userConfirmed:true});expect(new QqPackageStore(root,()=>ctx).getSelected()?.packageId).toBe(one.packageId);expect(()=>store.install(input(),{userConfirmed:true})).toThrow('release-replay-blocked');const two=store.install(input({releaseSequence:2}),{userConfirmed:true});expect(two.packageId).not.toBe(one.packageId);expect(store.rollback({userConfirmed:true}).packageId).toBe(one.packageId);expect(()=>store.install(input({releaseSequence:2}),{userConfirmed:true})).toThrow('release-replay-blocked');ctx={...ctx,trustedKeys:new Map()};expect(()=>store.getSelected()).toThrow('untrusted-publisher');ctx={...context(),now:2000};expect(()=>store.getSelected()).toThrow('expired-manifest');});
